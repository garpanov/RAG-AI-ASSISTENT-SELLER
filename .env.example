DATABASE_URL=postgresql+psycopg_async://user:password@localhost:5432/mydatabase
RABBITMQ_URL=amqp://guest:guest@localhost/
KNOWLEDGE_QUEUE_NAME=knowledge.documents.index
MESSAGE_QUEUE_NAME=conversations.messages.process

EMBEDDING_PROVIDER=qwen3
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16

KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200

PLANNER_PROVIDER=gemini
PLANNER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PLANNER_API_KEY=
PLANNER_MODEL_NAME=gemini-3.5-flash-lite
PLANNER_TIMEOUT_SECONDS=60.0
PLANNER_HANDOFF_CONFIDENCE_THRESHOLD=70

RAG_CANDIDATE_K=30
RAG_TOP_K=5
RERANKER_PROVIDER=vector
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B

ANSWER_PROVIDER=gemini
ANSWER_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANSWER_API_KEY=
ANSWER_MODEL_NAME=gemini-3.6-flash
ANSWER_TIMEOUT_SECONDS=60.0

ORDERS_BASE_URL=
ORDERS_API_KEY=
COMPANY_WEBHOOK_URL=
COMPANY_WEBHOOK_SECRET=
INTEGRATION_TIMEOUT_SECONDS=15.0
